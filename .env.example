# Never commit real credentials. Runtime entry points read environment variables.
# Load this private file explicitly with node --env-file=.env index.mjs (stdio)
# or node --env-file=.env server.mjs (hosted HTTP with existing OAuth settings).
APIOSK_GATEWAY_V2_URL=https://gateway.apiosk.com
APIOSK_CONNECT_TOKEN=
# APIOSK_TOKEN overrides APIOSK_CONNECT_TOKEN; a personal App session JWT
# enables account-only operations while valid. No automatic JWT refresh.
# APIOSK_TOKEN=
# APIOSK_WORKSPACE_ID=
# APIOSK_MCP_STATE_DIR=/absolute/private/path/to/mcp-state
APIOSK_MCP_PORT=3000
# The minimal local tester transport can override this port with --port 3012.
# APIOSK_GATEWAY_URL is reserved for the OAuth agent gateway; retain the existing
# hosted OAuth issuer/signing settings separately. It does not select data APIs.
