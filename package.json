{
  "name": "@apiosk/mcp",
  "version": "3.0.0",
  "description": "Ask-first Apiosk MCP with source-backed answers and embedded review components",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "apiosk-mcp-server": "index.mjs",
    "apiosk-mcp": "index.mjs",
    "apiosk": "index.mjs",
    "apiosk-mcp-2": "bin/mcp-2.mjs"
  },
  "scripts": {
    "build:ask-page": "node scripts/build-ask-page.mjs",
    "start": "node server.mjs",
    "start:http": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dev:chat": "node dev/host.mjs",
    "start:stdio": "node index.mjs",
    "dev": "node server.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "express": "5.2.1"
  },
  "main": "index.mjs",
  "mcpName": "io.github.obcraft/apiosk-mcp",
  "author": "Apiosk",
  "license": "MIT",
  "homepage": "https://apiosk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/obcraft/apiosk-mcp.git"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "server.json",
    "dxt.json",
    "manifest.json",
    "assets",
    "plugin",
    "docs",
    "examples"
  ],
  "devDependencies": {
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12"
  }
}
