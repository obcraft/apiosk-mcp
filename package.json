{
  "name": "@apiosk/mcp",
  "version": "3.0.0",
  "description": "Ask-first Apiosk MCP with source-backed answers and embedded review components",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "apiosk-mcp-server": "index.mjs",
    "apiosk-mcp": "index.mjs",
    "apiosk": "index.mjs",
    "apiosk-mcp-2": "bin/mcp-2.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:http": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dev:chat": "node dev/host.mjs",
    "start:stdio": "node index.mjs",
    "dev": "node server.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "express": "5.2.1"
  },
  "main": "index.mjs",
  "mcpName": "io.github.obcraft/apiosk-mcp",
  "author": "Apiosk",
  "license": "MIT",
  "homepage": "https://apiosk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/obcraft/apiosk-mcp.git"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "server.json",
    "dxt.json",
    "manifest.json",
    "assets",
    "plugin",
    "docs",
    "examples"
  ]
}
