{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.obcraft/apiosk-mcp",
  "title": "Apiosk Ask",
  "description": "Ask data questions, compare matching sources, approve one price, and reopen saved evidence.",
  "version": "3.0.0",
  "websiteUrl": "https://apiosk.com",
  "icons": [
    {
      "src": "https://mcp.apiosk.com/brand/apiosk-a-20260921.png",
      "mimeType": "image/png",
      "sizes": [
        "1254x1254"
      ],
      "theme": "light"
    },
    {
      "src": "https://mcp.apiosk.com/brand/mark-20260918.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://mcp.apiosk.com/brand/mark-light-20260918.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "light"
    },
    {
      "src": "https://mcp.apiosk.com/brand/mark-dark-20260918.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "dark"
    }
  ],
  "repository": {
    "url": "https://github.com/obcraft/apiosk-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@apiosk/mcp",
      "version": "3.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIOSK_CONNECT_TOKEN",
          "description": "Existing Apiosk agent connection token for stdio. Hosted connections use the configured OAuth flow.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "APIOSK_GATEWAY_V2_URL",
          "description": "Optional Gateway v2 origin override for local or staging use.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "APIOSK_MCP_STATE_DIR",
          "description": "Persistent private directory for saved conversations and approval journals.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apiosk.com/mcp"
    }
  ],
  "_meta": {
    "com.apiosk": {
      "tags": [
        "api",
        "data",
        "research",
        "evidence",
        "mcp"
      ],
      "categories": [
        "data",
        "productivity"
      ],
      "tools": [
        "apiosk_ask",
        "apiosk_capabilities",
        "apiosk_sources",
        "apiosk_prepare",
        "apiosk_approve",
        "apiosk_status",
        "apiosk_requote",
        "apiosk_continue",
        "apiosk_result",
        "apiosk_evidence",
        "apiosk_artifact",
        "apiosk_result_page",
        "apiosk_follow_up",
        "apiosk_retry_search",
        "apiosk_chats",
        "apiosk_integrations",
        "apiosk_integration_connect",
        "apiosk_actions",
        "apiosk_action_prepare",
        "apiosk_action_edit",
        "apiosk_action_execute",
        "apiosk_recurring_access",
        "apiosk_recurring_list",
        "apiosk_recurring_read",
        "apiosk_recurring_destinations",
        "apiosk_recurring_channel_review",
        "apiosk_recurring_channel_create",
        "apiosk_recurring_quote",
        "apiosk_recurring_approve",
        "apiosk_recurring_change_review",
        "apiosk_recurring_change_apply",
        "apiosk_review_read",
        "apiosk_schedule_handoff",
        "apiosk_task_options",
        "apiosk_source_selection",
        "apiosk_analysis_quote"
      ]
    }
  }
}
