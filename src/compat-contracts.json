{
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "state_ref",
      "revision",
      "expires_at",
      "focus",
      "state_token"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "2"
      },
      "state_ref": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      },
      "focus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_refs",
          "goal_refs"
        ],
        "properties": {
          "entity_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "goal_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "state_token": {
        "type": "string",
        "maxLength": 128
      }
    }
  },
  "discover": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "question"
    ],
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "state": {
        "description": "Copy the complete last state envelope unchanged.",
        "type": [
          "object",
          "null"
        ]
      },
      "context_delta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "explicit_values": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_ref",
                "semantic_type",
                "value"
              ],
              "properties": {
                "entity_ref": {
                  "type": "string",
                  "format": "uuid"
                },
                "semantic_type": {
                  "type": "string"
                },
                "value": {}
              }
            }
          },
          "requested_focus_refs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  },
  "execute": {
    "type": "object",
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "action_id",
          "state"
        ],
        "not": {
          "required": [
            "recover_task_ref"
          ]
        }
      },
      {
        "required": [
          "recover_task_ref"
        ],
        "not": {
          "required": [
            "action_id"
          ]
        }
      }
    ],
    "properties": {
      "action_id": {
        "type": "string",
        "format": "uuid"
      },
      "state": {
        "type": "object"
      },
      "recover_task_ref": {
        "type": "string",
        "format": "uuid",
        "description": "Recover state using a previously gateway-issued task reference. Reads only; does not execute or parse."
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "idempotency_key": {
        "type": "string",
        "format": "uuid"
      },
      "quote_ref": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid"
      },
      "authorization_ref": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid"
      },
      "input": {}
    }
  },
  "ask": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "question"
    ],
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "The person's question in their own words, unchanged. Send the same question again when preparing a chosen source."
      },
      "endpoint_id": {
        "type": "string",
        "format": "uuid",
        "description": "Only when preparing: the endpoint_id of a supported candidate from the previous apiosk_ask result."
      },
      "capability": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Only when preparing: that candidate's capability."
      },
      "input": {
        "type": "object",
        "maxProperties": 64,
        "description": "Only when preparing: that candidate's endpoint.input_values, completed with its endpoint.inputs fields the person supplied; each value follows that field's schema. For a signed source selection on hosts with cached schemas, use only apiosk_source_selection_v1 containing parsed_request, search_id and selections, with no top-level endpoint_id or capability.",
        "properties": {
          "apiosk_source_selection_v1": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parsed_request",
              "search_id",
              "selections"
            ],
            "properties": {
              "parsed_request": {
                "type": "object",
                "description": "For selections: copy the complete parsed_request from the source search unchanged."
              },
              "search_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000000,
                "description": "For selections: copy the signed search_id from the source search unchanged."
              },
              "selections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "description": "The exact sources the person selected. Prepares one combined quote without approving or buying.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "endpoint_id",
                    "capability",
                    "input"
                  ],
                  "properties": {
                    "endpoint_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "subject_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "input": {
                      "type": "object",
                      "maxProperties": 64
                    }
                  }
                }
              }
            }
          }
        }
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "parsed_request": {
        "type": "object",
        "description": "For selections: copy the complete parsed_request from the source search unchanged."
      },
      "search_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000000,
        "description": "For selections: copy the signed search_id from the source search unchanged."
      },
      "selections": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "description": "The exact sources the person selected. Prepares one combined quote without approving or buying.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint_id",
            "capability",
            "input"
          ],
          "properties": {
            "endpoint_id": {
              "type": "string",
              "format": "uuid"
            },
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "subject_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "input": {
              "type": "object",
              "maxProperties": 64
            }
          }
        }
      },
      "research": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parsed_request",
          "search_id"
        ],
        "description": "Plan the complete question from its displayed source search, without reinterpreting or approving it.",
        "properties": {
          "parsed_request": {
            "type": "object",
            "description": "For selections: copy the complete parsed_request from the source search unchanged."
          },
          "search_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000,
            "description": "For selections: copy the signed search_id from the source search unchanged."
          },
          "discovery_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          }
        }
      },
      "task_refs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "description": "For a follow-up on existing purchases, copy the saved task references from this chat, most recent first. The gateway routes saved evidence, new data or clarification without purchasing."
      },
      "refresh": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parsed_request",
          "search_id"
        ],
        "description": "Retry source search using its existing interpretation. No new parse, task or purchase.",
        "properties": {
          "parsed_request": {
            "type": "object",
            "description": "For selections: copy the complete parsed_request from the source search unchanged."
          },
          "search_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000,
            "description": "For selections: copy the signed search_id from the source search unchanged."
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "selections"
          ]
        },
        "then": {
          "required": [
            "parsed_request",
            "search_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "endpoint_id"
                ]
              },
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "input"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "anyOf": [
            {
              "required": [
                "parsed_request"
              ]
            },
            {
              "required": [
                "search_id"
              ]
            }
          ]
        },
        "then": {
          "required": [
            "selections"
          ]
        }
      },
      {
        "if": {
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "required": [
                "apiosk_source_selection_v1"
              ]
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "endpoint_id"
                ]
              },
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "selections"
                ]
              },
              {
                "required": [
                  "parsed_request"
                ]
              },
              {
                "required": [
                  "search_id"
                ]
              }
            ]
          },
          "properties": {
            "input": {
              "maxProperties": 1
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "input"
          ],
          "not": {
            "required": [
              "endpoint_id"
            ]
          }
        },
        "then": {
          "properties": {
            "input": {
              "required": [
                "apiosk_source_selection_v1"
              ]
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "research"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "endpoint_id"
                ]
              },
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "input"
                ]
              },
              {
                "required": [
                  "parsed_request"
                ]
              },
              {
                "required": [
                  "search_id"
                ]
              },
              {
                "required": [
                  "selections"
                ]
              },
              {
                "required": [
                  "task_refs"
                ]
              },
              {
                "required": [
                  "refresh"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "required": [
            "task_refs"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "endpoint_id"
                ]
              },
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "input"
                ]
              },
              {
                "required": [
                  "parsed_request"
                ]
              },
              {
                "required": [
                  "search_id"
                ]
              },
              {
                "required": [
                  "selections"
                ]
              },
              {
                "required": [
                  "research"
                ]
              },
              {
                "required": [
                  "refresh"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "required": [
            "refresh"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "endpoint_id"
                ]
              },
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "input"
                ]
              },
              {
                "required": [
                  "parsed_request"
                ]
              },
              {
                "required": [
                  "search_id"
                ]
              },
              {
                "required": [
                  "selections"
                ]
              },
              {
                "required": [
                  "research"
                ]
              },
              {
                "required": [
                  "task_refs"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
