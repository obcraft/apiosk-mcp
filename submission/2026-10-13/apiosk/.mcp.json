{
  "mcpServers": {
    "apiosk": {
      "type": "http",
      "url": "https://mcp.apiosk.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.apiosk.com/",
            "authorizationUrl": "https://mcp.apiosk.com/authorize",
            "tokenUrl": "https://mcp.apiosk.com/token",
            "registrationUrl": "https://mcp.apiosk.com/register",
            "resource": "https://mcp.apiosk.com/mcp",
            "baseScopes": [
              "mcp:tools",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
